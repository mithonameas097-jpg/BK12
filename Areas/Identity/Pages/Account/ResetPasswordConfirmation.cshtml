@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <!-- Success Card Container -->
            <div class="card text-light shadow-lg" style="background-color: #050A2E; border: 2px solid #ffc107; border-radius: 15px;">

                <!-- Card Header -->
                <div class="card-header text-center py-4" style="background-color: #ffc107; border-top-left-radius: 13px; border-top-right-radius: 13px;">
                    <div class="mb-2">
                        <span class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-check-lg text-warning fs-1" style="color: #ffc107 !important;">✓</i>
                        </span>
                    </div>
                    <h3 class="mb-0 fw-bold text-dark">Password Updated</h3>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5 text-center" style="background-color: #050A2E; border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">

                    <h4 class="text-white fw-bold mb-3">You're All Set!</h4>
                    <p class="text-light mb-4" style="line-height: 1.6; color: #a0aec0 !important;">
                        Your BK 12 account password has been successfully reset. You can now securely log in to your profile, view upcoming matches, and manage your tickets.
                    </p>

                    <div class="d-grid gap-2 mb-4">
                        <a asp-page="./Login" class="btn btn-warning fw-bold py-3 text-dark shadow" style="background-color: #ffc107; border-color: #ffc107; border-radius: 8px; font-size: 1.05rem;">
                            Log In to Your Account
                        </a>
                    </div>

                    <hr style="border-color: #ffc107; opacity: 0.3;" class="my-4">

                    <div class="text-muted small">
                        <p class="mb-0" style="color: #8fa1b8 !important;">
                            Didn't request this change? Please contact the <span class="text-warning">BK 12 System Administrator</span> immediately.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>