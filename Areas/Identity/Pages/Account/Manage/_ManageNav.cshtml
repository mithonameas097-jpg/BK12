@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> Icon = @<svg class="bk-manage-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item" /></svg>;
}
<style>
    .bk-manage-nav {
        padding: .75rem;
        background: var(--bk-navy-2);
        border: 1px solid var(--bk-line);
        border-radius: 16px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, .35);
    }

    .bk-manage-nav-label {
        color: var(--bk-muted);
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        margin: .25rem 0 .6rem .75rem;
    }

    .bk-manage-nav .nav {
        gap: .25rem;
    }

    .bk-manage-nav .nav-link {
        position: relative;
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .65rem .85rem;
        border-radius: 10px;
        color: var(--bk-muted);
        font-weight: 500;
        font-size: .93rem;
        transition: background .15s ease, color .15s ease, transform .15s ease;
    }

    .bk-manage-icon {
        flex: 0 0 auto;
        opacity: .85;
        transition: color .15s ease, opacity .15s ease;
    }

    .bk-manage-nav .nav-link:hover {
        background: rgba(255, 255, 255, .05);
        color: var(--bk-text);
        transform: translateX(2px);
    }

    .bk-manage-nav .nav-link.active {
        background: linear-gradient(90deg, rgba(var(--bk-gold-rgb), .18), rgba(var(--bk-gold-rgb), .04));
        color: var(--bk-gold);
        font-weight: 600;
    }

        .bk-manage-nav .nav-link.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 22%;
            bottom: 22%;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: var(--bk-gold);
        }

        .bk-manage-nav .nav-link.active .bk-manage-icon,
        .bk-manage-nav .nav-link:hover .bk-manage-icon {
            opacity: 1;
        }

    .bk-manage-nav .nav-link:focus-visible {
        outline: 2px solid rgba(var(--bk-gold-rgb), .6);
        outline-offset: 2px;
    }

    @@media (max-width: 767.98px) {
        .bk-manage-nav {
            padding: .5rem;
        }

        .bk-manage-nav-label {
            display: none;
        }

        .bk-manage-nav .nav {
            flex-direction: row;
            flex-wrap: nowrap;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .bk-manage-nav .nav::-webkit-scrollbar {
                display: none;
            }

        .bk-manage-nav .nav-link {
            white-space: nowrap;
            padding: .55rem .9rem;
        }

            .bk-manage-nav .nav-link:hover {
                transform: none;
            }

            .bk-manage-nav .nav-link.active::before {
                left: 22%;
                right: 22%;
                top: auto;
                bottom: 0;
                width: auto;
                height: 3px;
                border-radius: 3px 3px 0 0;
            }
    }
</style>

<nav class="bk-manage-nav" aria-label="Account settings">
    <div class="bk-manage-nav-label">Account</div>
    <ul class="nav nav-pills flex-column">
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
                @Icon("M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z")
                <span>Profile</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
                @Icon("M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM22 6l-10 7L2 6")
                <span>Email</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
                @Icon("M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4")
                <span>Password</span>
            </a>
        </li>
        @if (hasExternalLogins)
        {
            <li id="external-logins" class="nav-item">
                <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                    @Icon("M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7")
                    <span>External logins</span>
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
                @Icon("M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                <span>Two-factor authentication</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
                @Icon("M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3")
                <span>Personal data</span>
            </a>
        </li>
    </ul>
</nav>
