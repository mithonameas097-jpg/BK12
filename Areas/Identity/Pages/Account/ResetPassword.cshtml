@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<style>
    :root {
        --bk-navy: #070b24;
        --bk-navy-2: #0d1233;
        --bk-gold: #e8b93c;
        --bk-text: #e8eaf2;
        --bk-muted: #8a90ad;
        --bk-line: #1c2450;
    }

    .bk-auth-card {
        background: var(--bk-navy-2);
        border: 1px solid var(--bk-line);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
        max-width: 440px;
        margin: 2rem auto;
    }

        .bk-auth-card h1 {
            color: var(--bk-gold);
            font-weight: 700;
            font-size: 1.6rem;
            letter-spacing: .3px;
            margin-bottom: .25rem;
        }

        .bk-auth-card h2 {
            color: var(--bk-muted);
            font-size: 1rem;
            font-weight: 400;
            margin-bottom: 1.5rem;
        }

        .bk-auth-card hr {
            border-color: var(--bk-line);
            opacity: 1;
            margin-bottom: 1.5rem;
        }

        .bk-auth-card .form-floating > .form-control,
        .bk-auth-card .form-floating > label {
            color: var(--bk-text);
        }

        .bk-auth-card .form-control {
            background: var(--bk-navy);
            border: 1px solid var(--bk-line);
            color: var(--bk-text);
        }

            .bk-auth-card .form-control:focus {
                background: var(--bk-navy);
                color: var(--bk-text);
                border-color: var(--bk-gold);
                box-shadow: 0 0 0 .2rem rgba(232, 185, 60, .2);
            }

            .bk-auth-card .form-control::placeholder {
                color: var(--bk-muted);
            }

        .bk-auth-card .form-floating > label {
            color: var(--bk-muted);
        }

        .bk-auth-card .text-danger {
            color: #ff8a8a !important;
        }

        .bk-auth-card .btn-primary {
            background: var(--bk-gold);
            border-color: var(--bk-gold);
            color: var(--bk-navy);
            font-weight: 600;
            letter-spacing: .3px;
            transition: background .2s, color .2s;
        }

            .bk-auth-card .btn-primary:hover,
            .bk-auth-card .btn-primary:focus {
                background: #f5cf6a;
                border-color: #f5cf6a;
                color: var(--bk-navy);
            }
</style>

<div class="bk-auth-card">
    <h1>@ViewData["Title"]</h1>
    <h2>Reset your password.</h2>
    <hr />
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label"></label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
            <label asp-for="Input.Password" class="form-label"></label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="w-100 btn btn-lg btn-primary">Reset</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
