@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .auth-page {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #070b24;
        padding: 40px 16px;
        position: relative;
        overflow: hidden;
    }

    /* spotlight glow behind the crest */
    .auth-spotlight {
        position: absolute;
        width: 560px;
        height: 560px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(58, 96, 220, .38) 0%, rgba(43, 62, 207, .18) 40%, transparent 70%);
        pointer-events: none;
        z-index: 0;
        left: calc(50% - 470px);
        top: 50%;
        transform: translateY(-50%);
    }

    .auth-crest {
        position: relative;
        z-index: 1;
        flex: 0 0 auto;
        width: 440px;
        margin-right: -150px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-crest img {
        width: 100%;
        filter: drop-shadow(0 0 45px rgba(43, 62, 207, .45));
    }

    .auth-card {
        position: relative;
        z-index: 2;
        width: min(420px, 100%);
        background: linear-gradient(160deg, #0e1438 0%, #0a0e2c 100%);
        border: 1px solid #1c2450;
        border-radius: 20px;
        padding: 40px 38px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, .55);
    }

    .auth-card h1 {
        font-size: 19px;
        font-weight: 600;
        text-align: center;
        margin-bottom: 8px;
        letter-spacing: .2px;
    }

    .auth-card .sub {
        text-align: center;
        color: #8a90ad;
        font-size: 13.5px;
        margin-bottom: 26px;
    }

    .auth-card .gold {
        color: #e8b93c;
    }

    .bk-field {
        width: 100%;
        background: #0a0f2b;
        border: 1.5px solid #c9a24a;
        border-radius: 8px;
        padding: 13px 16px;
        color: #e8eaf2;
        font-size: 14.5px;
        margin-bottom: 16px;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

    .bk-field::placeholder {
        color: #a8adbf;
    }

    .bk-field:focus {
        border-color: #e8b93c;
        box-shadow: 0 0 0 3px rgba(232, 185, 60, .12);
    }

    .bk-check {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #cfd3e4;
        font-size: 14px;
        margin-bottom: 20px;
        user-select: none;
    }

    .bk-check input {
        accent-color: #e8b93c;
        width: 16px;
        height: 16px;
    }

    .btn-bk-primary {
        width: 100%;
        background: #2b3ecf;
        border: none;
        border-radius: 999px;
        padding: 14px;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

    .btn-bk-primary:hover {
        background: #3b4ee0;
    }

    .btn-bk-google {
        width: 100%;
        background: #eceef1;
        color: #1f2430;
        border: none;
        border-radius: 999px;
        padding: 13px;
        font-size: 15px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        transition: .2s;
    }

    .btn-bk-google:hover {
        background: #ffffff;
    }

    .bk-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 24px 0;
        color: #e8eaf2;
        font-size: 15px;
    }

    .bk-divider::before,
    .bk-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #2a3368, transparent);
    }

    .bk-links {
        margin-top: 24px;
        text-align: center;
        font-size: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .bk-links a {
        color: #8a90ad;
        text-decoration: none;
        transition: color .2s;
    }

    .bk-links a:hover {
        color: #e8b93c;
    }

    .bk-validation {
        color: #e06c75;
        font-size: 13px;
        display: block;
        margin: -10px 0 12px;
    }

    .no-ext {
        color: #8a90ad;
        font-size: 13.5px;
        text-align: center;
    }

    .no-ext a {
        color: #e8b93c;
    }

    @@media (max-width: 900px) {
        .auth-crest, .auth-spotlight {
            display: none;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-spotlight"></div>

    <aside class="auth-crest">
        <img src="data:image/png;base64," alt="BK12 Boeung Ket Football Club crest" />
    </aside>

    <section class="auth-card">
        <h1>Get Back On The <span class="gold">Field</span></h1>
        <p class="sub">We are glad to see you again</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <input asp-for="Input.Email" class="bk-field" autocomplete="username"
                   aria-required="true" placeholder="Email" />
            <span asp-validation-for="Input.Email" class="bk-validation"></span>

            <input asp-for="Input.Password" type="password" class="bk-field"
                   autocomplete="current-password" aria-required="true" placeholder="Password" />
            <span asp-validation-for="Input.Password" class="bk-validation"></span>

            <label class="bk-check">
                <input asp-for="Input.RememberMe" />
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>

            <button id="login-submit" type="submit" class="btn-bk-primary">Log in</button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="bk-divider">Or</div>
            <form id="external-account" asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn-bk-google" name="provider"
                            value="@provider.Name"
                            title="Log in using your @provider.DisplayName account">
                        @if (provider.Name == "Google")
                        {
                            @Html.Raw("<svg width=\"18\" height=\"18\" viewBox=\"0 0 48 48\"><path fill=\"#FFC107\" d=\"M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z\"/><path fill=\"#FF3D00\" d=\"M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z\"/><path fill=\"#4CAF50\" d=\"M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.2-8l-6.5 5C9.5 39.6 16.2 44 24 44z\"/><path fill=\"#1976D2\" d=\"M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.4 35.2 44 30 44 24c0-1.3-.1-2.6-.4-3.9z\"/></svg>")
                        }
                        <span>Continue with @provider.DisplayName</span>
                    </button>
                }
            </form>
        }
        else
        {
            <p class="no-ext" style="margin-top:18px;">
                No external login services configured yet.
                <a href="https://go.microsoft.com/fwlink/?LinkID=532715">Set one up</a>.
            </p>
        }

        <div class="bk-links">
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
