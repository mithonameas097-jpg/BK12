@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Match Requests Management";
}

<style>
    body {
        background-color: #04071C;
        color: #f8fafc;
    }

    .container-custom {
        max-width: 1200px;
        margin: 0 auto;
    }

    .card-custom {
        background-color: #050A2E;
        border: 1px solid rgba(227, 166, 73, 0.4);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .table-dark-custom {
        background-color: #04071C;
        color: #f8fafc;
        border-color: rgba(227, 166, 73, 0.2);
    }

        .table-dark-custom th {
            background-color: #050A2E;
            color: #E3A649;
            border-bottom: 2px solid rgba(227, 166, 73, 0.4);
        }

        .table-dark-custom td {
            background-color: #04071C;
            color: #f8fafc;
            border-color: rgba(227, 166, 73, 0.1);
            vertical-align: middle;
        }

    .btn-gold {
        background-color: #E3A649;
        color: #04071C;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
    }

        .btn-gold:hover {
            background-color: #d2953e;
            color: #04071C;
        }
</style>

<div class="container my-5 container-custom">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background-color: #065f46; color: #d1fae5; border: 1px solid #10b981; border-radius: 8px;">
            @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0" style="color: #E3A649;">Match Requests Management</h3>
            <a asp-action="MatchRequest" class="btn btn-gold">Create New Request</a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Home Club</th>
                        <th>Away Club</th>
                        <th>Stadium</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        @foreach (DataRow row in Model.Rows)
                        {
                            var reqId = row.Table.Columns.Contains("Request_ID") ? row["Request_ID"] : row[0];
                            var home = row.Table.Columns.Contains("Home_Club_Name") ? row["Home_Club_Name"] : (row.Table.Columns.Contains("Home_Club") ? row["Home_Club"] : "N/A");
                            var away = row.Table.Columns.Contains("Away_Club_Name") ? row["Away_Club_Name"] : (row.Table.Columns.Contains("Away_Club") ? row["Away_Club"] : "N/A");
                            var stadium = row.Table.Columns.Contains("Stadium_Name") ? row["Stadium_Name"] : (row.Table.Columns.Contains("Stadium_ID") ? row["Stadium_ID"] : "N/A");

                            string scheduleStr = "N/A";
                            if (row.Table.Columns.Contains("Schedule") && row["Schedule"] != DBNull.Value)
                            {
                                scheduleStr = Convert.ToDateTime(row["Schedule"]).ToString("yyyy-MM-dd HH:mm");
                            }

                            var statusStr = row.Table.Columns.Contains("Status") ? row["Status"]?.ToString() ?? "Pending" : "Pending";

                            <tr>
                                <td>@reqId</td>
                                <td>@home</td>
                                <td>@away</td>
                                <td>@stadium</td>
                                <td>@scheduleStr</td>
                                <td>
                                    <span class="badge @(statusStr == "Approved" ? "bg-success" : (statusStr == "Pending" ? "bg-warning text-dark" : "bg-danger"))" style="padding: 6px 10px; border-radius: 6px;">
                                        @statusStr
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="MatchRequestEdit" asp-route-id="@reqId" class="btn btn-sm btn-outline-warning px-3 py-1.5" style="border-radius: 6px; border-color: #E3A649; color: #E3A649;">Edit</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">No match requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>