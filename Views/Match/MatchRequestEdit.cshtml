@model _bk12.Models.MatchEditViewModel
@{
    ViewData["Title"] = "Edit Match Request";
    var clubs = ViewBag.Clubs as IEnumerable<dynamic> ?? new List<dynamic>();
    var stadiums = ViewBag.Stadiums as IEnumerable<dynamic> ?? new List<dynamic>();

    string matchDateStr = Model.MatchDate.ToString("yyyy-MM-dd");
    string matchTimeStr = Model.MatchTime.ToString(@"hh\:mm");
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    body {
        background-color: #04071C;
        color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .edit-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .edit-card {
        background: linear-gradient(145deg, #050A2E, #04071C);
        border: 1px solid rgba(227, 166, 73, 0.3);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        padding: 40px;
        position: relative;
        overflow: hidden;
    }

        .edit-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #E3A649, #b87d23);
        }

    .form-label {
        color: #E3A649;
        font-weight: 600;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        background-color: #04071C;
        border: 1px solid rgba(227, 166, 73, 0.25);
        color: #f8fafc;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            background-color: #04071C;
            border-color: #E3A649;
            color: #f8fafc;
            box-shadow: 0 0 0 0.25rem rgba(227, 166, 73, 0.2);
        }

        .form-control::placeholder {
            color: rgba(248, 250, 252, 0.4);
        }

    .btn-gold {
        background: linear-gradient(135deg, #E3A649, #c7892b);
        color: #04071C;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(227, 166, 73, 0.3);
    }

        .btn-gold:hover {
            background: linear-gradient(135deg, #f0b55b, #d5922e);
            color: #04071C;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(227, 166, 73, 0.4);
        }

    .btn-outline-custom {
        border: 1px solid rgba(227, 166, 73, 0.4);
        color: #E3A649;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        background: transparent;
        transition: all 0.3s ease;
    }

        .btn-outline-custom:hover {
            background-color: rgba(227, 166, 73, 0.1);
            color: #f8fafc;
            border-color: #E3A649;
        }

    .badge-id {
        background-color: rgba(227, 166, 73, 0.15);
        color: #E3A649;
        border: 1px solid rgba(227, 166, 73, 0.3);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }
</style>

<div class="edit-container">
    <div class="edit-card">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
            <div>
                <h3 class="fw-bold mb-1" style="color: #E3A649;">Edit Match Request</h3>
                <p class="text-muted mb-0 small">Update match details, venues, or schedules below.</p>
            </div>
            <span class="badge-id">Request ID: #@Model.Request_ID</span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert" style="background-color: rgba(127, 29, 29, 0.85); color: #fee2e2; border: 1px solid #ef4444; border-radius: 12px;">
                <div class="d-flex align-items-center mb-1 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Validation Error
                </div>
                <ul class="mb-0 ps-3 small">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="MatchRequestEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Request_ID" />

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label">Home Club</label>
                    <select asp-for="Home_Club" class="form-select" required>
                        <option value="">-- Select Home Club --</option>
                        @foreach (var club in clubs)
                        {
                            string selected = club.Club_ID == Model.Home_Club ? "selected" : "";
                            <!option value="@club.Club_ID" @selected>@club.Club_Name</!option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label">Away Club</label>
                    <select asp-for="Away_Club" class="form-select" required>
                        <option value="">-- Select Away Club --</option>
                        @foreach (var club in clubs)
                        {
                            string selected = club.Club_ID == Model.Away_Club ? "selected" : "";
                            <!option value="@club.Club_ID" @selected>@club.Club_Name</!option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Stadium Venue</label>
                <select asp-for="Stadium_ID" class="form-select" required>
                    <option value="">-- Select Stadium --</option>
                    @foreach (var stadium in stadiums)
                    {
                        string selected = stadium.Stadium_ID == Model.Stadium_ID ? "selected" : "";
                        <!option value="@stadium.Stadium_ID" @selected>@stadium.Stadium_Name</!option>
                    }
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label">Match Date</label>
                    <input type="date" name="MatchDate" class="form-control" value="@matchDateStr" required />
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label">Match Time</label>
                    <input type="time" name="MatchTime" class="form-control" value="@matchTimeStr" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Additional Notes / Reason for Edit</label>
                <textarea asp-for="Note" class="form-control" rows="3" placeholder="Provide any details regarding this change..."></textarea>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                <a asp-action="MatchEditList" class="btn btn-outline-custom">Back to List</a>
                <button type="submit" class="btn btn-gold">
                    @(isAdmin ? "Save Changes Directly" : "Submit Edit Request")
                </button>
            </div>
        </form>
    </div>
</div>