@{
    ViewData["Title"] = "About Us";
}

<section class="about-page">
    <div class="hero">
        <div class="hero__overlay"></div>
        <div class="hero__inner">
            <p class="eyebrow">About Us</p>
            <h1 class="hero__title">Bring Fans Closer<br />to the Game</h1>
            <p class="hero__text">
                Got a question, a match-day issue, or just want to talk
                football? We're here for it. Our team is ready to help you
                get sorted, fast — so you never miss a moment of the action.
            </p>
        </div>
    </div>
    <div class="what-we-do">
        <p class="eyebrow">What We Do</p>

        <div class="services">
            <div class="service">
                <span class="service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3M3.5 9h17M5 5h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V6.5A1.5 1.5 0 0 1 5 5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <h3>Browse Matches</h3>
                <p>Discover upcoming football matches and events.</p>
            </div>

            <div class="service">
                <span class="service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.5a1.5 1.5 0 0 0 0-3V9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M9 7v10" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" /></svg>
                </span>
                <h3>Choose Zones</h3>
                <p>Select your desired zones with various choices.</p>
            </div>

            <div class="service">
                <span class="service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z" fill="currentColor" /></svg>
                </span>
                <h3>Get Digital Tickets</h3>
                <p>Receive your QR code tickets instantly in your device.</p>
            </div>

            <div class="service">
                <span class="service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3a5 5 0 0 0-5 5v3.2c0 .6-.2 1.1-.6 1.6L5 15h14l-1.4-2.2c-.4-.5-.6-1-.6-1.6V8a5 5 0 0 0-5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M10 18a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
                <h3>Daily Updates</h3>
                <p>Visit for daily updates on league and competitive tournaments.</p>
            </div>

            <div class="service">
                <span class="service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 6v6c0 4.5 3.4 7.9 8 9 4.6-1.1 8-4.5 8-9V6l-8-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <h3>Trust and Secure</h3>
                <p>Your data and payments are always protected.</p>
            </div>
        </div>
    </div>
    <div class="team">
        <div class="team__cards">

            <div class="team-card">
                <div class="team-card__photo">
                    <img src="~/images/about/dev-phoureach.jpg" alt="Phou Reach" />
                    <span class="team-card__badge team-card__badge--dev">Developer</span>
                </div>
                <h4>Phou Reach</h4>
                <p>Frontend and Backend Development</p>
                <div class="team-card__social">
                    <a href="#" aria-label="Telegram">
                        <svg viewBox="0 0 24 24"><path d="M21.9 4.6 18.9 19c-.2 1-.9 1.2-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9L18 6.2c.4-.4-.1-.6-.6-.2L7 12.9l-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3.4c.8-.3 1.6.2 1.3 1.2Z" fill="currentColor" /></svg>
                    </a>
                    <a href="#" aria-label="Facebook">
                        <svg viewBox="0 0 24 24"><path d="M14 9h2.5V6H14c-2 0-3.5 1.6-3.5 3.6V11H8v3h2.5v6h3v-6h2.3l.4-3h-2.7V9.8c0-.5.4-.8 1-.8Z" fill="currentColor" /></svg>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" /></svg>
                    </a>
                </div>
            </div>

            <div class="team-card team-card--mentor">
                <div class="team-card__photo">
                    <img src="~/images/about/mentor-hensovatra.jpg" alt="Hen Sovatra" />
                    <span class="team-card__badge team-card__badge--mentor">Mentor</span>
                </div>
                <h4>Hen Sovatra</h4>
                <p>Project Guidance and Technical Support</p>
                <div class="team-card__social">
                    <a href="#" aria-label="Telegram">
                        <svg viewBox="0 0 24 24"><path d="M21.9 4.6 18.9 19c-.2 1-.9 1.2-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9L18 6.2c.4-.4-.1-.6-.6-.2L7 12.9l-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3.4c.8-.3 1.6.2 1.3 1.2Z" fill="currentColor" /></svg>
                    </a>
                    <a href="#" aria-label="Facebook">
                        <svg viewBox="0 0 24 24"><path d="M14 9h2.5V6H14c-2 0-3.5 1.6-3.5 3.6V11H8v3h2.5v6h3v-6h2.3l.4-3h-2.7V9.8c0-.5.4-.8 1-.8Z" fill="currentColor" /></svg>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" /></svg>
                    </a>
                </div>
            </div>

            <div class="team-card">
                <div class="team-card__photo">
                    <img src="/images/about/dev-measmithona.jpg" alt="Meas Mithona" />
                    <span class="team-card__badge team-card__badge--dev">Developer</span>
                </div>
                <h4>Meas Mithona</h4>
                <p>Database and Backend Development</p>
                <div class="team-card__social">
                    <a href="#" aria-label="Telegram">
                        <svg viewBox="0 0 24 24"><path d="M21.9 4.6 18.9 19c-.2 1-.9 1.2-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9L18 6.2c.4-.4-.1-.6-.6-.2L7 12.9l-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3.4c.8-.3 1.6.2 1.3 1.2Z" fill="currentColor" /></svg>
                    </a>
                    <a href="https://www.facebook.com/mithona.meas.56" aria-label="Facebook">
                        <svg viewBox="0 0 24 24"><path d="M14 9h2.5V6H14c-2 0-3.5 1.6-3.5 3.6V11H8v3h2.5v6h3v-6h2.3l.4-3h-2.7V9.8c0-.5.4-.8 1-.8Z" fill="currentColor" /></svg>
                    </a>
                    <a href="" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" /></svg>
                    </a>
                </div>
            </div>

        </div>
    </div>
    <div class="patch-notes">
        <p class="eyebrow">Patch notes</p>
        <p class="patch-notes__version">Version 1.18.1.34</p>
        <p class="patch-notes__desc">Updated new information and new fonts</p>
    </div>

</section>

<style>
    :root {
        --navy: #0a0f2c;
        --navy-deep: #070b21;
        --navy-card: #10173a;
        --orange: #f5a623;
        --white: #ffffff;
        --muted: #aab0c6;
        --radius: 16px;
    }

    .about-page {
        font-family: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--navy);
        color: var(--white);
    }

    .about-page .eyebrow {
        color: var(--orange);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        margin: 0 0 0.5rem;
    }
    .hero {
        position: relative;
        min-height: 380px;
        display: flex;
        align-items: center;
        background: url("/images/about/hero-stadium.jpg") center / cover no-repeat;
        padding: 3rem 2rem;
        overflow: hidden;
    }

    .hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(7, 11, 33, 0.92) 0%, rgba(7, 11, 33, 0.55) 55%, rgba(7, 11, 33, 0.15) 100%);
    }

    .hero__inner {
        position: relative;
        max-width: 560px;
    }

    .hero__title {
        font-size: 2.5rem;
        line-height: 1.15;
        font-weight: 800;
        margin: 0 0 1rem;
    }

    .hero__text {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 460px;
        margin: 0;
    }
    .what-we-do {
        background: var(--navy-card);
        border-radius: var(--radius);
        margin: -1.5rem 1.5rem 0;
        padding: 2rem 1.5rem;
        position: relative;
        z-index: 2;
    }

    .services {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
    }

    .service {
        text-align: center;
        padding: 0 1rem;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
    }

    .service:last-child {
        border-right: none;
    }

    .service__icon {
        display: inline-flex;
        width: 40px;
        height: 40px;
        color: var(--orange);
        margin-bottom: 0.75rem;
    }

    .service__icon svg {
        width: 100%;
        height: 100%;
    }

    .service h3 {
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0 0 0.4rem;
    }

    .service p {
        font-size: 0.8rem;
        color: var(--muted);
        line-height: 1.5;
        margin: 0;
    }

    .team {
        background: url("/images/about/field-bg.jpg") center / cover no-repeat;
        padding: 4rem 1.5rem 3rem;
        margin-top: 1.5rem;
    }

    .team__cards {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 1.25rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .team-card {
        background: var(--navy-card);
        border-radius: var(--radius);
        padding: 1.25rem 1.25rem 1.5rem;
        width: 220px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .team-card--mentor {
        transform: translateY(-24px);
        width: 240px;
    }

    .team-card__photo {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
        aspect-ratio: 4 / 3;
    }

    .team-card__photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .team-card__badge {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        color: var(--white);
    }

    .team-card__badge--dev {
        background: #2f5dd6;
    }

    .team-card__badge--mentor {
        background: var(--orange);
        color: var(--navy-deep);
    }

    .team-card h4 {
        margin: 0 0 0.25rem;
        font-size: 1rem;
        font-weight: 700;
    }

    .team-card p {
        margin: 0 0 0.9rem;
        font-size: 0.78rem;
        color: var(--muted);
        line-height: 1.4;
        min-height: 2.2em;
    }

    .team-card__social {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
    }

    .team-card__social a {
        display: inline-flex;
        width: 22px;
        height: 22px;
        color: var(--muted);
        transition: color 0.15s ease;
    }

    .team-card__social a:hover {
        color: var(--orange);
    }

    .team-card__social svg {
        width: 100%;
        height: 100%;
    }


    .patch-notes {
        background: var(--navy-card);
        border-radius: var(--radius);
        margin: 0 1.5rem 2rem;
        padding: 1.5rem;
    }

    .patch-notes__version {
        margin: 0 0 0.25rem;
        font-weight: 700;
    }

    .patch-notes__desc {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
    }

    @@media (max-width: 900px) {
        .services {
            grid-template-columns: repeat(3, 1fr);
            row-gap: 1.5rem;
        }

        .service:nth-child(3) {
            border-right: none;
        }

        .team__cards {
            flex-wrap: wrap;
        }

        .team-card--mentor {
            order: -1;
            transform: none;
        }
    }

    @@media (max-width: 560px) {
        .hero__title {
            font-size: 1.9rem;
        }

        .services {
            grid-template-columns: repeat(2, 1fr);
        }

        .service {
            border-right: none;
        }

        .team-card {
            width: 100%;
            max-width: 260px;
        }
    }
</style>
