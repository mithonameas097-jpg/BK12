@{
    ViewData["Title"] = "Contact Us";
}

<div class="bk-content p-0">
    <!-- Top Hero Section with background image -->
    <div class="bk-contact-hero">
        <div class="container py-4">
            <span class="text-uppercase text-warning fw-bold small tracking-wide" style="letter-spacing: 1.5px;">Contact Us</span>
            <h1 class="display-5 fw-bold text-white mt-1 mb-3">We're Here to Help</h1>
            <p class="text-secondary mb-0" style="max-width: 480px; font-size: 0.95rem; line-height: 1.6;">
                Every fan deserves a front-row seat to the moments that matter. We've made it faster and easier than ever to get there — so all you have to do is show up and roar.
            </p>
        </div>
    </div>

    <!-- Main Content Body Container -->
    <div class="container my-5">
        <div class="bk-contact-card p-4 p-md-5">

            <!-- Section Title -->
            <div class="text-center mb-5">
                <h3 class="fw-bold text-white m-0">Contact Information</h3>
            </div>

            <div class="row align-items-center position-relative" style="z-index: 2;">
                <!-- Contact Details Column -->
                <div class="col-lg-7">

                    <!-- Email Item -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="text-warning fs-5 me-3 mt-1">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <span class="d-block text-secondary small fw-medium mb-1">Email</span>
                            <a href="mailto:mithonameas097@gmail.com" class="text-white text-decoration-none fw-semibold fs-6">
                                mithonameas097@gmail.com
                            </a>
                        </div>
                    </div>

                    <!-- Phone Item -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="text-warning fs-5 me-3 mt-1">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <span class="d-block text-secondary small fw-medium mb-1">Phone</span>
                            <a href="tel:069208248" class="text-white text-decoration-none fw-semibold fs-6">
                                069 208 248
                            </a>
                        </div>
                    </div>

                    <!-- Website Address Item -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="text-warning fs-5 me-3 mt-1">
                            <i class="bi bi-globe"></i>
                        </div>
                        <div>
                            <span class="d-block text-secondary small fw-medium mb-1">Website Address</span>
                            <a href="https://www.bk12.com" target="_blank" class="text-warning text-decoration-none fw-semibold fs-6">
                                www.bk12.com
                            </a>
                        </div>
                    </div>

                    <!-- Follow Us / Social Icons -->
                    <div class="mt-4 pt-2">
                        <span class="d-block text-warning small fw-bold mb-3">Follow Us</span>
                        <div class="d-flex gap-2">
                            <!-- Telegram -->
                            <a href="#" class="bk-social-icon" aria-label="Telegram">
                                <i class="bi bi-telegram"></i>
                            </a>
                            <!-- Facebook -->
                            <a href="#" class="bk-social-icon" aria-label="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <!-- Twitter/X -->
                            <a href="#" class="bk-social-icon" aria-label="Twitter">
                                <i class="bi bi-twitter-x"></i>
                            </a>
                            <!-- Instagram -->
                            <a href="#" class="bk-social-icon" aria-label="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Background Watermark Logo (Right side inside the card) -->
            <div class="bk-watermark-container d-none d-lg-block">
                <img src="~/images/about/compressed-logo.png" alt="Watermark Logo" />
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Optional: Ensure Bootstrap Icons are loaded in your _Layout.cshtml head if icons do not appear -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}