@model System.Data.DataTable

@{
    ViewData["Title"] = "Stadium Management";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    body {
        background-color: #04071C;
        color: #f8fafc;
    }

    .admin-card {
        background-color: #050A2E;
        border: 1px solid #1e293b;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .table-dark-custom {
        background-color: #0f172a;
        color: #f8fafc;
        border-color: #334155;
    }

        .table-dark-custom th {
            background-color: #1e293b;
            color: #f59e0b;
            border-bottom: 2px solid #334155;
        }

        .table-dark-custom td {
            border-color: #334155;
            vertical-align: middle;
        }

    .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .clickable-row:hover {
            background-color: #1e293b !important;
        }

    .btn-amber {
        background-color: #f59e0b;
        color: #0f172a;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }

        .btn-amber:hover {
            background-color: #d97706;
            color: #ffffff;
        }
</style>

<div class="container my-5" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-warning mb-1">
                <i class="bi bi-building me-2"></i> Stadium Management
            </h2>
            <p class="text-muted small mb-0">@(isAdmin ? "Overview of all stadiums in the system. Click any row to edit." : "Overview of your registered stadiums. Click any row to edit.")</p>
        </div>
        <a asp-action="StadiumRequest" class="btn btn-amber px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Stadium
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Stadium Name</th>
                        <th>Location</th>
                        <th>Capacity</th>
                        <th>Zone A</th>
                        <th>Zone B</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string imgPath = row["Stadium_IMG"] != DBNull.Value ? row["Stadium_IMG"].ToString()! : "/images/default-stadium.png";
                            string location = row["Stadium_Location"] != DBNull.Value ? row["Stadium_Location"].ToString()! : "-";
                            string mapUrl = row["Map_Url"] != DBNull.Value ? row["Map_Url"].ToString()! : "#";
                            int capacity = row["Capacity"] != DBNull.Value ? Convert.ToInt32(row["Capacity"]) : 0;
                            int zoneA = row["ZoneA"] != DBNull.Value ? Convert.ToInt32(row["ZoneA"]) : 0;
                            int zoneB = row["ZoneB"] != DBNull.Value ? Convert.ToInt32(row["ZoneB"]) : 0;
                            bool isInactive = row["Inactive"] != DBNull.Value && Convert.ToBoolean(row["Inactive"]);
                            int stadiumId = row["Stadium_ID"] != DBNull.Value ? Convert.ToInt32(row["Stadium_ID"]) : 0;

                            <tr class="clickable-row" onclick="window.location='@Url.Action("StadiumEdit", "Stadium", new { id = stadiumId })';">
                                <td>
                                    <img src="@imgPath" alt="Stadium" class="rounded" style="width: 50px; height: 40px; object-fit: cover;" onerror="this.src='/images/default-stadium.png';" />
                                </td>
                                <td class="fw-bold text-warning">@row["Stadium_Name"]</td>
                                <td class="text-slate-300">@location</td>
                                <td>@capacity.ToString("N0")</td>
                                <td>@zoneA.ToString("N0")</td>
                                <td>@zoneB.ToString("N0")</td>
                                <td>
                                    @if (isInactive)
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td class="text-end" onclick="event.stopPropagation();">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="@mapUrl" target="_blank" class="btn btn-sm btn-outline-info" title="View Map">
                                            <i class="bi bi-map"></i>
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <form asp-action="ToggleStatus" asp-route-id="@stadiumId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                @if (isInactive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success" title="Activate Stadium">
                                                        <i class="bi bi-check-circle"></i> Activate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate Stadium">
                                                        <i class="bi bi-x-circle"></i> Deactivate
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No stadiums found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>