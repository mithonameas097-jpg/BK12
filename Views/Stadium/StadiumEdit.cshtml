@model _bk12.Models.StadiumRequestViewModel

@{
    ViewData["Title"] = "Edit Stadium";
    int stadiumId = ViewBag.StadiumId ?? 0;
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    body {
        background-color: #04071C;
        color: #f8fafc;
    }

    .form-card {
        background-color: #050A2E;
        border: 1px solid #1e293b;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .form-control, .form-select {
        background-color: #0f172a;
        border: 1px solid #334155;
        color: #f8fafc;
    }

        .form-control:focus, .form-select:focus {
            background-color: #0f172a;
            border-color: #f59e0b;
            color: #f8fafc;
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.25);
        }

    .btn-amber {
        background-color: #f59e0b;
        color: #0f172a;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }

        .btn-amber:hover {
            background-color: #d97706;
            color: #ffffff;
        }
</style>

<div class="container my-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-warning mb-1">
                <i class="bi bi-pencil-square me-2"></i> Edit Stadium
            </h2>
            <p class="text-muted small mb-0">@(isAdmin ? "Modify stadium details directly." : "Submit updates for admin approval.")</p>
        </div>
        <a asp-action="StadiumManage" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="form-card">
        <form asp-controller="Stadium" asp-action="StadiumEdit" asp-route-id="@stadiumId" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Stadium_IMG" />

            <div asp-validation-summary="All" class="alert alert-danger bg-danger text-white border-0 mb-4" role="alert"></div>

            <!-- Stadium Name & Location Row -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StadiumName" class="form-label text-warning fw-semibold">Stadium Name</label>
                    <input asp-for="StadiumName" class="form-control rounded-pill px-3 py-2" placeholder="Enter stadium name..." />
                    <span asp-validation-for="StadiumName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Stadium_Location" class="form-label text-warning fw-semibold">Stadium Location</label>
                    <input asp-for="Stadium_Location" class="form-control rounded-pill px-3 py-2" placeholder="e.g., Phnom Penh, Cambodia" />
                    <span asp-validation-for="Stadium_Location" class="text-danger small"></span>
                </div>
            </div>

            <!-- Capacities Row -->
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Capacity" class="form-label text-warning fw-semibold">Total Capacity</label>
                    <input asp-for="Capacity" type="number" class="form-control rounded-pill px-3 py-2" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ZoneA" class="form-label text-warning fw-semibold">Zone A Capacity</label>
                    <input asp-for="ZoneA" type="number" class="form-control rounded-pill px-3 py-2" />
                    <span asp-validation-for="ZoneA" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ZoneB" class="form-label text-warning fw-semibold">Zone B Capacity</label>
                    <input asp-for="ZoneB" type="number" class="form-control rounded-pill px-3 py-2" />
                    <span asp-validation-for="ZoneB" class="text-danger small"></span>
                </div>
            </div>

            <!-- Image Upload -->
            <div class="mb-3">
                <label class="form-label text-warning fw-semibold">Stadium Image</label>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <img src="@(string.IsNullOrEmpty(Model?.Stadium_IMG) ? "/images/default-stadium.png" : Model.Stadium_IMG)"
                         alt="Current Image"
                         class="rounded"
                         style="width: 80px; height: 60px; object-fit: cover;"
                         onerror="this.src='/images/default-stadium.png';" />
                    <input type="file" name="stadiumFile" class="form-control rounded-pill px-3 py-2" accept="image/*" />
                </div>
                <div class="form-text text-muted small">Upload a new image to replace the current one.</div>
            </div>

            <!-- Map URL -->
            <div class="mb-3">
                <label asp-for="Map_Url" class="form-label text-warning fw-semibold">Map URL (Google Maps)</label>
                <input asp-for="Map_Url" class="form-control rounded-pill px-3 py-2" placeholder="https://maps.google.com/..." />
                <span asp-validation-for="Map_Url" class="text-danger small"></span>
            </div>


            <div class="mb-4">
                <label asp-for="Description" class="form-label text-warning fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control rounded-4 p-3" rows="4" placeholder="Enter stadium description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="StadiumManage" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-bold">Cancel</a>
                <button type="submit" class="btn btn-amber px-5 py-2 rounded-pill shadow-sm">
                    @if (isAdmin)
                    {
                        <i class="bi bi-check2-circle me-1"></i><span>Save Changes</span>
                    }
                    else
                    {
                        <i class="bi bi-send me-1"></i><span>Submit Edit Request</span>
                    }
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}