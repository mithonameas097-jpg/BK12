@model _bk12.Models.ClubRequestViewModel

@{
    ViewData["Title"] = "Submit Club Request";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-2 rounded-4 p-4 p-md-5" style="background-color: #0b132b; border-color: #ffb703 !important; color: #ffffff;">

                <div class="text-center mb-4">
                    <h2 class="fw-bold text-warning">Submit New Club Request</h2>
                    <p class="text-light">Provide your club details and upload or link a logo.</p>
                </div>

                <form asp-action="ClubRequest" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-4 align-items-center">
                        <div class="col-md-4 text-center">
                            <div class="p-3 border border-warning rounded-3 bg-dark shadow-sm">
                                <label class="form-label text-warning fw-bold mb-3">Club Logo Preview</label>

                                <div class="mb-3 d-flex justify-content-center align-items-center bg-black rounded" style="height: 160px; overflow: hidden;">
                                    <img id="logoPreview" src="/images/default-club.png" alt="Logo Preview" class="img-fluid" style="max-height: 150px; object-fit: contain;" />
                                </div>

                                <div class="text-start">
                                    <label asp-for="LogoFile" class="form-label text-light small">Upload Image File</label>
                                    <input asp-for="LogoFile" type="file" class="form-control form-control-sm bg-dark text-white border-secondary" id="logoFileInput" accept=".png,.jpg,.jpeg" />
                                    <span asp-validation-for="LogoFile" class="text-danger small"></span>
                                </div>

                                <div class="text-start mt-2">
                                    <label asp-for="Logo_Url" class="form-label text-light small">Or Paste Image URL</label>
                                    <input asp-for="Logo_Url" class="form-control form-control-sm bg-dark text-white border-secondary" id="logoUrlInput" placeholder="https://..." />
                                    <span asp-validation-for="Logo_Url" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="ClubName" class="form-label text-light fw-bold">Club Name</label>
                                <input asp-for="ClubName" class="form-control bg-dark text-white border-secondary" placeholder="Enter club name..." />
                                <span asp-validation-for="ClubName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label text-light fw-bold">Description</label>
                                <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="5" placeholder="Enter club description, history, or goals..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a asp-action="Manage" class="btn btn-outline-light px-4">Back to Portal</a>
                                <button type="submit" class="btn btn-warning fw-bold px-5 text-dark">Submit Request</button>
                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const logoFileInput = document.getElementById('logoFileInput');
        const logoUrlInput = document.getElementById('logoUrlInput');
        const logoPreview = document.getElementById('logoPreview');

        logoFileInput.addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    logoPreview.src = e.target.result;
                }
                reader.readAsDataURL(file);
                logoUrlInput.value = '';
            }
        });

        logoUrlInput.addEventListener('input', function(event) {
            const url = event.target.value.trim();
            if (url) {
                logoPreview.src = url;
                logoFileInput.value = '';
            } else {
                logoPreview.src = '/images/default-club.png';
            }
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}