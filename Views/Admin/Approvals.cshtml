@model dynamic
@{
    ViewData["Title"] = "Approvals";
    string currentTab = ViewBag.CurrentTab as string ?? "clubs";
}

<style>
    body {
        background-color: #04071C;
        color: #f8fafc;
    }

    .admin-container {
        background-color: #050A2E;
        border: 1px solid #1e293b;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .custom-table {
        color: #f8fafc;
        background-color: transparent;
    }

        .custom-table th {
            background-color: #1e293b !important;
            color: #94a3b8;
            font-weight: 600;
            border-bottom: 1px solid #334155;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }

        .custom-table td {
            background-color: transparent !important;
            color: #e2e8f0;
            border-bottom: 1px solid #1e293b;
            vertical-align: middle;
            padding: 16px 12px;
        }

        .custom-table tr:hover td {
            background-color: rgba(30, 41, 59, 0.5) !important;
        }

    .btn-amber {
        background-color: #f59e0b;
        color: #0f172a;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }

        .btn-amber:hover {
            background-color: #d97706;
            color: #ffffff;
        }

    .form-select-custom {
        background-color: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155;
    }

        .form-select-custom:focus {
            background-color: #0f172a;
            color: #f8fafc;
            border-color: #f59e0b;
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.25);
        }

    /* Styles matching the Match Request popup card design */
    .match-review-card {
        background-color: #050A2E;
        border: 2px solid #E3A649;
        border-radius: 20px;
        padding: 20px;
        color: #f8fafc;
    }

    .pill-box {
        background-color: #04071C;
        border: 1px solid #E3A649;
        border-radius: 12px;
        padding: 8px 14px;
        color: #f8fafc;
        font-size: 0.9rem;
    }

    .club-pill {
        background-color: #04071C;
        border: 1px solid #E3A649;
        border-radius: 30px;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .club-logo {
        width: 38px;
        height: 38px;
        object-fit: contain;
        border-radius: 50%;
        background-color: #fff;
        padding: 2px;
    }

    .stadium-card-review {
        background-color: #04071C;
        border: 1px solid #E3A649;
        border-radius: 16px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stadium-img-review {
        width: 110px;
        height: 65px;
        object-fit: cover;
        border-radius: 10px;
    }

    .note-white-box {
        background-color: #ffffff;
        color: #0f172a;
        border-radius: 14px;
        padding: 14px 18px;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.5;
    }

    .text-gold-label {
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .text-subtext {
        color: rgba(248, 250, 252, 0.7);
        font-size: 0.85rem;
    }
</style>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="fw-bold text-warning mb-0"><i class="bi bi-people-fill me-2"></i> Request Approvals</h2>

        <div class="d-flex align-items-center gap-2">
            <label for="tableSelector" class="text-muted small fw-bold text-uppercase">Viewing:</label>
            <select id="tableSelector" class="form-select form-select-custom rounded-pill px-3 py-2 fw-bold" style="width: 220px;">
                <option value="clubs" selected="@(currentTab == "clubs")">Club Requests</option>
                <option value="stadiums" selected="@(currentTab == "stadiums")">Stadium Requests</option>
                <option value="matches" selected="@(currentTab == "matches")">Match Requests</option>
            </select>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="admin-container">
        @if (currentTab == "clubs")
        {
            var clubList = Model as IEnumerable<_bk12.Data.ClubRequest>;
            if (clubList == null || !clubList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <p class="mb-0">There are no pending club requests to review.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Requested By</th>
                                <th>Club Name</th>
                                <th>Request Type</th>
                                <th>Submitted Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in clubList)
                            {
                                <tr>
                                    <td class="font-monospace text-warning fw-bold">R-@item.Id.ToString("D3")</td>
                                    <td>@item.UserId</td>
                                    <td class="fw-bold text-white">@item.ClubName</td>
                                    <td>
                                        @if (item.Request_Type == "ClaimClub")
                                        {
                                            <span class="badge bg-info text-dark">Claim Club</span>
                                        }
                                        else if (item.Request_Type == "EditClub")
                                        {
                                            <span class="badge bg-warning text-dark">Edit Club</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">New Club</span>
                                        }
                                    </td>
                                    <td>@item.SubmittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-amber btn-sm px-3 py-2 rounded-pill shadow-sm review-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal"
                                                data-target-type="club"
                                                data-request-id="@item.Id"
                                                data-name="@item.ClubName"
                                                data-description="@item.Description"
                                                data-logo="@item.Logo_Url"
                                                data-date="@item.SubmittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")"
                                                data-username="@item.UserId"
                                                data-request-type="@item.Request_Type">
                                            <i class="bi bi-file-earmark-text me-1"></i> Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (currentTab == "stadiums")
        {
            var stadiumTable = Model as System.Data.DataTable;
            if (stadiumTable == null || stadiumTable.Rows.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <p class="mb-0">There are no pending stadium requests to review.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Requested By</th>
                                <th>Stadium Name</th>
                                <th>Request Type</th>
                                <th>Capacity</th>
                                <th>Submitted Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in stadiumTable.Rows)
                            {
                                int requestId = Convert.ToInt32(row["Request_ID"]);
                                string userId = row["User_ID"].ToString()!;
                                string stadiumName = row["Stadium_Name"].ToString()!;
                                string requestType = row["Request_Type"].ToString()!;
                                string description = row["Description"] != DBNull.Value ? row["Description"].ToString()! : "";
                                string logoUrl = row["Stadium_IMG"] != DBNull.Value ? row["Stadium_IMG"].ToString()! : "";
                                int capacity = row["Capacity"] != DBNull.Value ? Convert.ToInt32(row["Capacity"]) : 0;
                                int zoneA = row["ZoneA"] != DBNull.Value ? Convert.ToInt32(row["ZoneA"]) : 0;
                                int zoneB = row["ZoneB"] != DBNull.Value ? Convert.ToInt32(row["ZoneB"]) : 0;
                                DateTime submittedDate = Convert.ToDateTime(row["Request_Date"]);

                                <tr>
                                    <td class="font-monospace text-warning fw-bold">SR-@requestId.ToString("D3")</td>
                                    <td>@userId</td>
                                    <td class="fw-bold text-white">@stadiumName</td>
                                    <td>
                                        @if (requestType == "EditStadium")
                                        {
                                            <span class="badge bg-warning text-dark">Edit Stadium</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">New Stadium</span>
                                        }
                                    </td>
                                    <td>@capacity.ToString("N0") (A: @zoneA, B: @zoneB)</td>
                                    <td>@submittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-amber btn-sm px-3 py-2 rounded-pill shadow-sm review-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal"
                                                data-target-type="stadium"
                                                data-request-id="@requestId"
                                                data-name="@stadiumName"
                                                data-description="@description"
                                                data-logo="@logoUrl"
                                                data-date="@submittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")"
                                                data-username="@userId"
                                                data-request-type="@requestType">
                                            <i class="bi bi-file-earmark-text me-1"></i> Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (currentTab == "matches")
        {
            var matchRequests = Model as IEnumerable<_bk12.Data.MatchRequest>;
            if (matchRequests == null || !matchRequests.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <p class="mb-0">There are no pending match requests to review.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Home Club</th>
                                <th>Away Club</th>
                                <th>Stadium</th>
                                <th>Match Schedule</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in matchRequests)
                            {
                                <tr>
                                    <td class="font-monospace text-warning fw-bold">MR-@item.Request_ID.ToString("D3")</td>
                                    <td class="fw-bold text-white">@item.Home_Club_Name</td>
                                    <td class="fw-bold text-white">@item.Away_Club_Name</td>
                                    <td>@item.Stadium_Name</td>
                                    <td>@item.Schedule.ToString("MMM d, yyyy h:mm tt")</td>
                                    <td>
                                        <span class="badge @(item.Status == "Approved" ? "bg-success" : (item.Status == "Pending" ? "bg-warning text-dark" : "bg-danger"))">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-amber btn-sm px-3 py-2 rounded-pill shadow-sm review-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal"
                                                data-target-type="match"
                                                data-request-id="@item.Request_ID"
                                                data-username="@item.User_ID"
                                                data-requested-date="@item.Requested_Date.ToString("dd-MMM-yyyy, hh:mm tt")"
                                                data-match-date="@item.Schedule.ToString("dd-MMM-yyyy")"
                                                data-match-time="@item.Schedule.ToString("h:mm tt")"
                                                data-home-name="@item.Home_Club_Name"
                                                data-home-logo="@item.Home_Logo"
                                                data-away-name="@item.Away_Club_Name"
                                                data-away-logo="@item.Away_Logo"
                                                data-stadium-name="@item.Stadium_Name"
                                                data-stadium-location="@item.Stadium_Location"
                                                data-stadium-img="@item.Stadium_IMG"
                                                data-note="@item.Add_Note">
                                            <i class="bi bi-file-earmark-text me-1"></i> Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">

            <div class="modal-header px-4 py-3 border-bottom border-secondary position-relative">
                <h4 class="modal-title fw-bold text-warning mx-auto" id="reviewModalLabel">Request Review</h4>
                <button type="button" class="btn-close btn-close-white position-absolute end-0 me-4" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div id="matchReviewContainer" class="match-review-card d-none">
                    <div class="row mb-3 align-items-start">
                        <div class="col-6">
                            <div class="mb-3">
                                <span class="text-gold-label d-block">Requested By</span>
                                <span id="matchRequestedBy" class="fw-bold fs-6 text-white">-</span>
                            </div>
                            <div>
                                <span class="text-gold-label d-block">Requested Date</span>
                                <span id="matchRequestedDate" class="text-subtext">-</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="row g-2 mb-2">
                                <div class="col-7">
                                    <span class="text-gold-label d-block">Date</span>
                                    <div class="pill-box d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-2 text-warning"></i>
                                        <span id="matchDateText">-</span>
                                    </div>
                                </div>
                                <div class="col-5">
                                    <span class="text-gold-label d-block">Time</span>
                                    <div class="pill-box d-flex align-items-center">
                                        <i class="bi bi-clock me-2 text-warning"></i>
                                        <span id="matchTimeText">-</span>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <span class="text-gold-label d-block">Timezone</span>
                                <div class="pill-box py-2">
                                    <span class="d-block text-subtext small">Indochina Time (ICT): UTC+7</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <span class="text-gold-label d-block">Home</span>
                            <div class="club-pill">
                                <img id="matchHomeLogo" src="/images/default-club.png" class="club-logo" alt="Home Club" />
                                <span id="matchHomeName" class="fw-bold text-truncate text-white">-</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <span class="text-gold-label d-block">Away</span>
                            <div class="club-pill">
                                <img id="matchAwayLogo" src="/images/default-club.png" class="club-logo" alt="Away Club" />
                                <span id="matchAwayName" class="fw-bold text-truncate text-white">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="stadium-card-review">
                            <img id="matchStadiumImg" src="/images/default-stadium.png" class="stadium-img-review" alt="Stadium" />
                            <div>
                                <h6 id="matchStadiumName" class="fw-bold mb-1 text-white">-</h6>
                                <span id="matchStadiumLocation" class="text-subtext small">-</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <span class="text-gold-label d-block mb-2">Note</span>
                        <div class="note-white-box">
                            <p id="matchNoteText" class="mb-0 text-dark">-</p>
                        </div>
                    </div>
                </div>

                <div id="defaultReviewContainer">
                    <div class="row align-items-stretch g-4">
                        <div class="col-md-7 d-flex flex-column justify-content-between">
                            <div class="p-3 rounded mb-3" style="background-color: #0f172a; border: 1px solid #334155;">
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Request Type</span>
                                    <strong id="modalRequestType" class="text-info">Loading...</strong>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Requested By (User ID)</span>
                                    <strong id="modalRequestedBy" class="text-white text-break">Loading...</strong>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block" id="modalEntityLabel">Entity Name</span>
                                    <strong id="modalClubName" class="text-warning text-break fs-5">Loading...</strong>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Requested Date</span>
                                    <strong id="modalDate" class="text-light">Loading...</strong>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <span class="text-muted small fw-bold d-block mb-1">Message / Description</span>
                                <div id="modalDescription" class="p-3 rounded bg-dark border border-secondary text-light overflow-auto" style="max-height: 180px; font-size: 0.9rem; line-height: 1.5; white-space: pre-line;">
                                    Loading description...
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 d-flex flex-column align-items-center justify-content-center text-center">
                            <span class="text-muted small fw-bold d-block mb-3" id="modalImageLabel">Logo / Image</span>

                            <div class="rounded-circle border border-secondary shadow-lg p-1 bg-dark" style="width: 160px; height: 160px;">
                                <img id="modalLogoImg"
                                     src=""
                                     alt="Image Preview"
                                     class="rounded-circle w-100 h-100"
                                     style="object-fit: cover; display: block;"
                                     onerror="this.onerror=null; this.src='/images/default-club.png';" />
                            </div>
                        </div>
                    </div>
                </div>

                <div id="rejectionSection" class="collapse mt-3 pt-3 border-top border-secondary">
                    <label for="rejectedReasonInput" class="form-label text-danger fw-bold small">Reason for Rejection <span class="text-danger">*</span></label>
                    <textarea class="form-control bg-dark text-light border-secondary" id="rejectedReasonInput" rows="2" placeholder="Provide feedback to the owner..."></textarea>
                </div>
            </div>

            <div class="modal-footer px-4 py-3 border-top border-secondary justify-content-between">
                <form id="actionForm" method="post" class="w-100 d-flex justify-content-between align-items-center">
                    <input type="hidden" id="modalRequestId" name="id" />
                    <input type="hidden" id="modalActionType" name="actionType" value="" />
                    <input type="hidden" id="hiddenReason" name="rejectedReason" />
                    <input type="hidden" id="hiddenCurrentTab" name="tab" value="@currentTab" />

                    <div>
                        <button type="button" id="rejectToggleBtn" class="btn btn-danger px-4 py-2 rounded-pill fw-bold shadow-sm">
                            Reject
                        </button>
                    </div>

                    <div>
                        <button type="button" id="cancelRejectBtn" class="btn btn-outline-secondary px-3 py-2 rounded-pill me-2 collapse">Cancel</button>
                        <button type="submit" id="approveBtn" class="btn btn-success px-4 py-2 rounded-pill fw-bold shadow-sm" style="background-color: #22c55e; border: none;">
                            Approve
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const $reviewModal = $('#reviewModal');
            const $rejectionSection = $('#rejectionSection');
            const $rejectToggleBtn = $('#rejectToggleBtn');
            const $cancelRejectBtn = $('#cancelRejectBtn');
            const $modalActionType = $('#modalActionType');
            const $hiddenReason = $('#hiddenReason');
            const $rejectedReasonInput = $('#rejectedReasonInput');
            const $actionForm = $('#actionForm');

            $('#tableSelector').on('change', function() {
                const selectedTab = $(this).val();
                window.location.href = '@Url.Action("Approvals", "Admin")?tab=' + selectedTab;
            });

            $reviewModal.on('show.bs.modal', function(event) {
                const $button = $(event.relatedTarget);
                const targetType = $button.data('target-type');

                if (targetType === 'match') {
                    $('#defaultReviewContainer').addClass('d-none');
                    $('#matchReviewContainer').removeClass('d-none');
                    $actionForm.attr('action', '@Url.Action("UpdateMatchRequestStatus", "Admin")');

                    $('#matchRequestedBy').text($button.data('username') || 'System');
                    $('#matchRequestedDate').text($button.data('requested-date') || '-');
                    $('#matchDateText').text($button.data('match-date') || '-');
                    $('#matchTimeText').text($button.data('match-time') || '-');

                    $('#matchHomeName').text($button.data('home-name') || '-');
                    $('#matchHomeLogo').attr('src', $button.data('home-logo') || '/images/default-club.png');

                    $('#matchAwayName').text($button.data('away-name') || '-');
                    $('#matchAwayLogo').attr('src', $button.data('away-logo') || '/images/default-club.png');

                    $('#matchStadiumName').text($button.data('stadium-name') || '-');
                    $('#matchStadiumLocation').text($button.data('stadium-location') || 'Phnom Penh, Cambodia');
                    $('#matchStadiumImg').attr('src', $button.data('stadium-img') || '/images/default-stadium.png');

                    $('#matchNoteText').text($button.data('note') || 'No additional notes provided.');
                } else {
                    $('#matchReviewContainer').addClass('d-none');
                    $('#defaultReviewContainer').removeClass('d-none');

                    if (targetType === 'stadium') {
                        $actionForm.attr('action', '@Url.Action("UpdateStadiumRequestStatus", "Admin")');
                        $('#modalEntityLabel').text('Stadium Name');
                        $('#modalImageLabel').text('Stadium Image');
                    } else {
                        $actionForm.attr('action', '@Url.Action("UpdateRequestStatus", "Admin")');
                        $('#modalEntityLabel').text('Club Name');
                        $('#modalImageLabel').text('Club Logo');
                    }

                    $('#modalClubName').text($button.data('name'));
                    $('#modalRequestedBy').text($button.data('username'));
                    $('#modalDate').text($button.data('date'));
                    $('#modalDescription').text($button.data('description'));

                    const reqType = $button.data('request-type');
                    const $typeElement = $('#modalRequestType');
                    if (reqType === 'ClaimClub') {
                        $typeElement.text('Claim Existing Club').removeClass('text-primary text-warning').addClass('text-info');
                    } else if (reqType === 'EditClub') {
                        $typeElement.text('Edit Club Information').removeClass('text-primary text-info').addClass('text-warning');
                    } else if (reqType === 'EditStadium') {
                        $typeElement.text('Edit Stadium Information').removeClass('text-primary text-info').addClass('text-warning');
                    } else {
                        $typeElement.text('New Request').removeClass('text-info text-warning').addClass('text-primary');
                    }

                    let imgUrl = $button.data('logo');
                    if (imgUrl && typeof imgUrl === 'string' && imgUrl.trim() !== '' && imgUrl !== 'null') {
                        if (!imgUrl.startsWith('http') && !imgUrl.startsWith('/')) {
                            imgUrl = '/' + imgUrl;
                        }
                        $('#modalLogoImg').attr('src', imgUrl);
                    } else {
                        $('#modalLogoImg').attr('src', '/images/default-club.png');
                    }
                }

                $('#modalRequestId').val($button.data('request-id'));
                resetRejectionMode();
            });

            $rejectToggleBtn.on('click', function() {
                if (!$rejectionSection.hasClass('show')) {
                    $rejectionSection.collapse('show');
                    $cancelRejectBtn.collapse('show');
                    $rejectToggleBtn
                        .text('Confirm Rejection')
                        .removeClass('btn-danger')
                        .addClass('btn-warning');
                    $modalActionType.val('Reject');
                    setTimeout(() => $rejectedReasonInput.focus(), 150);
                } else {
                    const reason = $rejectedReasonInput.val().trim();
                    if (!reason) {
                        alert('Please provide a rejection reason.');
                        $rejectedReasonInput.focus();
                        return;
                    }

                    if (confirm('Are you sure you want to reject this request?')) {
                        $hiddenReason.val(reason);
                        $modalActionType.val('Reject');
                        $actionForm.submit();
                    }
                }
            });

            $cancelRejectBtn.on('click', function() {
                resetRejectionMode();
            });

            $('#approveBtn').on('click', function(e) {
                e.preventDefault();
                if (confirm('Are you sure you want to approve this request?')) {
                    $modalActionType.val('Approve');
                    $hiddenReason.val('');
                    $actionForm.submit();
                }
            });

            function resetRejectionMode() {
                $rejectionSection.collapse('hide');
                $cancelRejectBtn.collapse('hide');
                $rejectToggleBtn
                    .text('Reject')
                    .removeClass('btn-warning')
                    .addClass('btn-danger');
                $modalActionType.val('Approve');
                $rejectedReasonInput.val('');
                $hiddenReason.val('');
            }
        });
    </script>
}